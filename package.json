{
  "name": "cleos",
  "version": "1.3.3-rc",
  "engines": {
    "node": "v24.12.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "ng": "ng",
    "start:dev": "ng serve --port 4300",
    "start:pwa": "http-server dist/cleos/browser -p 4300 --ssl --cert server.crt --key server.key",
    "build": "ng build --configuration=production",
    "build-pwa": "ng build --configuration=pwa",
    "build-development": "ng build --configuration=development",
    "build:pwa-old": "docker build -t nails-app --build-arg BUILD_CONFIG=build-pwa --build-arg NGINX=nginx-staging.conf .",
    "postbuild-pwa": "cp -r ./src/manifest-dev.json ./dist/cleos/browser/manifest.json && cp ./src/firebase-messaging-sw-dev.js ./dist/cleos/browser/firebase-messaging-sw-dev.js",
    "build:source": "ng build --source-map",
    "test": "TZ=Europe/Amsterdam ng test --no-watch",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 ng lint",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 ng lint --fix",
    "eslint": "eslint src --fix",
    "e2e": "start-server-and-test serve http://localhost:4300 'cypress run --headless --reporter junit --reporter-options mochaFile=cypress/results/test-results.xml'",
    "serve": "ng serve --port 4300 --host 0.0.0.0 --no-hmr",
    "e2e-html-report": "npm run start:dev & npx wait-on http://localhost:4300 && npx cypress run --headless; exit_code=$?; npm run report:merge && npm run report:generate; exit $exit_code",
    "report:merge": "npx mochawesome-merge cypress/reports/mochawesome/*.json > cypress/reports/mochawesome/report.json",
    "report:generate": "npx marge cypress/reports/mochawesome/report.json -o cypress/reports/mochawesome",
    "heroku-postbuild": "ng build --configuration=staging",
    "emulator": "firebase emulators:start",
    "cypress:open": "TZ=Europe/Amsterdam npm run start:dev & npx wait-on http://localhost:4300 && npx cypress open",
    "cypress:run": "TZ=Europe/Amsterdam cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/cdk": "^21.2.3",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/google-maps": "^21.2.3",
    "@angular/material": "^21.2.3",
    "@angular/material-date-fns-adapter": "^21.2.3",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-browser-dynamic": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@angular/service-worker": "^21.2.5",
    "@aws-sdk/client-s3": "^3.1013.0",
    "@aws-sdk/client-sfn": "^3.1013.0",
    "@aws-sdk/credential-providers": "^3.1013.0",
    "@ng-icons/core": "^33.1.0",
    "@ng-icons/flag-icons": "^33.1.0",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/router-store": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@smithy/protocol-http": "^5.3.12",
    "@smithy/signature-v4": "^5.3.12",
    "angular-calendar": "^0.32.1",
    "angular-draggable-droppable": "^9.0.1",
    "angular-resizable-element": "^8.0.3",
    "chart.js": "4.5.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.11.0",
    "libphonenumber-js": "^1.12.40",
    "luxon": "^3.7.2",
    "ng2-charts": "^10.0.0",
    "ngrx-store-localstorage": "^20.1.0",
    "ngx-cookie-service": "^21.3.1",
    "ngx-cookieconsent": "^8.0.0",
    "ngx-material-intl-tel-input": "^21.0.0",
    "pdfmake": "^0.3.7",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.2",
    "timezones-list": "^3.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@angular/localize": "^21.2.5",
    "@types/file-saver": "^2.0.7",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/google.maps": "^3.58.1",
    "@types/html-to-pdfmake": "^2.4.4",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "cypress": "^15.12.0",
    "eslint": "^9.39.2",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jasmine-core": "^6.1.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-spec-reporter": "^0.0.36",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "start-server-and-test": "^2.1.5",
    "wait-on": "^9.0.4"
  }
}
