{
  "name": "nails-cleos",
  "version": "1.4.0-rc",
  "engines": {
    "node": "v24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "ng": "ng",
    "start:dev": "ng serve --port 4300",
    "start:pwa": "http-server dist/cleos/browser -p 4300 --ssl --cert server.crt --key server.key",
    "build": "ng build --configuration=production",
    "build-pwa": "ng build --configuration=pwa",
    "build-development": "ng build --configuration=development",
    "build:pwa-old": "docker build -t nails-app --build-arg BUILD_CONFIG=build-pwa --build-arg NGINX=nginx-staging.conf .",
    "postbuild-pwa": "cp -r ./src/manifest-dev.json ./dist/cleos/browser/manifest.json && cp ./src/firebase-messaging-sw-dev.js ./dist/cleos/browser/firebase-messaging-sw-dev.js",
    "build:source": "ng build --source-map",
    "test": "TZ=Europe/Amsterdam ng test --no-watch",
    "coverage:diff": "diff-cover coverage/cleos/lcov.info --compare-branch=$BASE --fail-under=80 --format html:coverage/diff-cover-report.html",
    "lint": "NODE_OPTIONS=--max-old-space-size=16384 ng lint --cache",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=16384 ng lint --cache --fix",
    "eslint": "eslint src --fix",
    "e2e": "start-server-and-test serve http://localhost:4300 'cypress run --headless --reporter junit --reporter-options mochaFile=cypress/results/test-results.xml'",
    "serve": "ng serve --port 4300 --host 0.0.0.0 --no-hmr",
    "e2e-html-report": "npm run start:dev & npx wait-on http://localhost:4300 && npx cypress run --headless; exit_code=$?; npm run report:merge && npm run report:generate; exit $exit_code",
    "report:merge": "npx mochawesome-merge cypress/results/mochawesome/*.json > cypress/results/mochawesome/report.json",
    "report:generate": "npx marge cypress/results/mochawesome/report.json -o cypress/results/mochawesome",
    "heroku-postbuild": "ng build --configuration=staging",
    "emulator": "firebase emulators:start",
    "cypress:open": "TZ=Europe/Amsterdam npm run start:dev & npx wait-on http://localhost:4300 && npx cypress open",
    "cypress:run": "TZ=Europe/Amsterdam cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/google-maps": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/material-date-fns-adapter": "^22.1.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@aws-crypto/sha256-browser": "^5.2.0",
    "@aws-sdk/client-s3": "^'3.1105.0",
    "@aws-sdk/client-sfn": "^'3.1105.0",
    "@aws-sdk/credential-provider-cognito-identity": "^3.972.66",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/flag-icons": "^35.0.1",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@smithy/protocol-http": "^5.5.16",
    "@smithy/signature-v4": "^5.6.12",
    "angular-calendar": "^0.32.2",
    "angular-draggable-droppable": "^9.0.1",
    "angular-resizable-element": "^8.0.3",
    "chart.js": "4.5.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.17.1",
    "libphonenumber-js": "^1.13.10",
    "ng2-charts": "^10.0.0",
    "ngrx-store-localstorage": "^20.1.0",
    "ngx-cookie-service": "^22.0.0",
    "ngx-cookieconsent": "^8.0.0",
    "ngx-material-intl-tel-input": "^22.1.0",
    "pdfmake": "^0.3.11",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.2",
    "timezones-list": "^3.1.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/google-libphonenumber": "^7.4.31",
    "@types/google.maps": "^3.58.1",
    "@types/html-to-pdfmake": "^2.4.5",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^24.12.4",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "cypress": "^15.12.0",
    "eslint": "^9.39.5",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.1.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-spec-reporter": "^0.0.36",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "start-server-and-test": "^2.1.5",
    "wait-on": "^9.0.10"
  }
}
