{
  "name": "cleos",
  "version": "1.2.2-rc",
  "engines": {
    "node": "v20.13.1",
    "npm": "10.5.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "start:dev": "ng serve",
    "start:pwa": "http-server -p 4200 -c-1 dist/cleos -P http://localhost:4200\\?",
    "build": "ng build --configuration=production",
    "build-pwa": "ng build --configuration=pwa",
    "build-development": "ng build --configuration=development",
    "build:pwa": "docker build -t nails-app --build-arg BUILD_CONFIG=build-pwa --build-arg NGINX=nginx-staging.conf .",
    "postbuild-pwa": "cp -r ./src/manifest-dev.json ./dist/cleos/manifest.json && cp ./src/firebase-messaging-sw-dev.js ./dist/cleos/firebase-messaging-sw-dev.js",
    "build:source": "ng build --source-map",
    "test": "ng test",
    "lint": "ng lint --fix",
    "eslint": "eslint src --fix",
    "e2e": "ng e2e",
    "heroku-postbuild": "ng build --configuration=staging",
    "emulator": "firebase emulators:start"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.12",
    "@angular/cdk": "^16.2.14",
    "@angular/common": "^16.2.12",
    "@angular/compiler": "^16.2.12",
    "@angular/core": "^16.2.12",
    "@angular/fire": "^7.6.1",
    "@angular/forms": "^16.2.12",
    "@angular/google-maps": "^16.2.12",
    "@angular/material": "^16.2.14",
    "@angular/material-date-fns-adapter": "^16.2.14",
    "@angular/platform-browser": "^16.2.12",
    "@angular/platform-browser-dynamic": "^16.2.12",
    "@angular/router": "^16.2.12",
    "@angular/service-worker": "^16.2.12",
    "@ngrx/effects": "^16.3.0",
    "@ngrx/store": "^16.3.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "angular-calendar": "^0.31.0",
    "chart.js": "^4.2.1",
    "cookieconsent": "^3.1.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "9.23.0",
    "firebaseui": "^6.1.0",
    "firebaseui-angular": "^6.1.4",
    "flag-icons": "^7.2.2",
    "html-to-pdfmake": "^2.4.20",
    "jspdf": "^2.5.1",
    "libphonenumber-js": "^1.10.24",
    "luxon": "^3.4.4",
    "ng2-charts": "^5.0.4",
    "ngrx-store-localstorage": "^16.0.0",
    "ngx-colors": "^3.6.0",
    "ngx-cookie-service": "^16.1.0",
    "ngx-cookieconsent": "^5.0.0",
    "ngx-mat-intl-tel-input": "^5.0.0",
    "ngx-material-timepicker": "^13.1.1",
    "path": "^0.12.7",
    "pdfmake": "^0.2.10",
    "replace-in-file": "^6.3.5",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.1",
    "rxjs-compat": "^6.6.7",
    "skeleton-screen-css": "^1.1.0",
    "timezones-list": "^3.0.3",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.14",
    "@angular-eslint/builder": "^16.3.1",
