{
  "name": "cleos",
  "version": "1.2.32-rc",
  "engines": {
    "node": "v24.12.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "start:dev": "ng serve --port 4300",
    "start:pwa": "http-server dist/cleos/browser -p 4300 --ssl --cert server.crt --key server.key",
    "build": "ng build --configuration=production",
    "build-pwa": "ng build --configuration=pwa",
    "build-development": "ng build --configuration=development",
    "build:pwa-old": "docker build -t nails-app --build-arg BUILD_CONFIG=build-pwa --build-arg NGINX=nginx-staging.conf .",
    "postbuild-pwa": "cp -r ./src/manifest-dev.json ./dist/cleos/browser/manifest.json && cp ./src/firebase-messaging-sw-dev.js ./dist/cleos/browser/firebase-messaging-sw-dev.js",
    "build:source": "ng build --source-map",
    "test": "ng test",
    "lint": "ng lint",
    "lint-fix": "ng lint --fix",
    "eslint": "eslint src --fix",
    "e2e": "start-server-and-test serve http://localhost:4300 'cypress run --headless --reporter junit --reporter-options mochaFile=cypress/results/test-results.xml'",
    "serve": "ng serve --port 4300 --host 0.0.0.0 --no-hmr",
    "e2e-html-report": "npm run start:dev & npx wait-on http://localhost:4300 && npx cypress run --headless; exit_code=$?; npm run report:merge && npm run report:generate; exit $exit_code",
    "report:merge": "npx mochawesome-merge cypress/reports/mochawesome/*.json > cypress/reports/mochawesome/report.json",
    "report:generate": "npx marge cypress/reports/mochawesome/report.json -o cypress/reports/mochawesome",
    "heroku-postbuild": "ng build --configuration=staging",
    "emulator": "firebase emulators:start",
    "cypress:open": "npm run start:dev & npx wait-on http://localhost:4300 && npx cypress open",
    "cypress:run": "cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.16",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.16",
    "@angular/compiler": "^20.3.16",
    "@angular/core": "^20.3.16",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.16",
    "@angular/google-maps": "^20.2.14",
    "@angular/material": "^20.2.14",
    "@angular/material-date-fns-adapter": "^20.2.14",
    "@angular/platform-browser": "^20.3.16",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@angular/router": "^20.3.16",
    "@angular/service-worker": "^20.3.16",
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/client-sfn": "^3.965.0",
    "@aws-sdk/credential-providers": "^3.965.0",
    "@aws-sdk/protocol-http": "^3.374.0",
    "@aws-sdk/signature-v4": "^3.374.0",
    "@ng-icons/core": "^32.5.0",
    "@ng-icons/flag-icons": "^32.5.0",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/router-store": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "angular-calendar": "^0.32.0",
    "chart.js": "^4.5.1",
    "cookieconsent": "^3.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.7.0",
    "libphonenumber-js": "^1.12.33",
    "luxon": "^3.7.2",
    "ng2-charts": "^8.0.0",
    "ngrx-store-localstorage": "^20.1.0",
    "ngx-color-picker": "^20.1.1",
    "ngx-cookie-service": "^20.1.1",
    "ngx-cookieconsent": "^8.0.0",
    "ngx-material-intl-tel-input": "^20.1.2",
    "ngx-material-timepicker": "^13.1.1",
    "path": "^0.12.7",
    "pdfmake": "^0.3.1",
    "replace-in-file": "^8.4.0",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.2",
    "rxjs-compat": "^6.6.7",
    "skeleton-screen-css": "^1.1.0",
    "timezones-list": "^3.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
