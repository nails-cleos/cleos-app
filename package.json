{
  "name": "cleos",
  "version": "1.2.9",
  "engines": {
    "node": "v20.13.1",
    "npm": "10.5.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "start:dev": "ng serve",
    "start:pwa": "http-server -p 4200 -c-1 dist/cleos -P http://localhost:4200\\?",
    "build": "ng build --configuration=production",
    "build-pwa": "ng build --configuration=pwa",
    "build-development": "ng build --configuration=development",
    "build:pwa": "docker build -t nails-app --build-arg BUILD_CONFIG=build-pwa --build-arg NGINX=nginx-staging.conf .",
    "postbuild-pwa": "cp -r ./src/manifest-dev.json ./dist/cleos/manifest.json && cp ./src/firebase-messaging-sw-dev.js ./dist/cleos/firebase-messaging-sw-dev.js",
    "build:source": "ng build --source-map",
    "test": "ng test",
    "lint": "ng lint --fix",
    "eslint": "eslint src --fix",
    "e2e": "ng e2e",
    "heroku-postbuild": "ng build --configuration=staging",
    "emulator": "firebase emulators:start"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.10",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.10",
    "@angular/compiler": "^17.3.10",
    "@angular/core": "^17.3.10",
    "@angular/fire": "^17.1.0",
    "@angular/forms": "^17.3.10",
    "@angular/google-maps": "^17.3.10",
    "@angular/material": "^17.3.10",
    "@angular/material-date-fns-adapter": "^17.3.10",
    "@angular/platform-browser": "^17.3.10",
    "@angular/platform-browser-dynamic": "^17.3.10",
    "@angular/router": "^17.3.10",
    "@angular/service-worker": "^17.3.10",
    "@ngrx/effects": "^17.2.0",
    "@ngrx/store": "^17.2.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "angular-calendar": "^0.31.1",
    "chart.js": "^4.4.3",
    "cookieconsent": "^3.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "10.12.2",
    "firebaseui": "^6.1.0",
    "firebaseui-angular": "^6.2.1",
    "flag-icons": "^7.2.3",
    "html-to-pdfmake": "^2.5.9",
    "jspdf": "^2.5.1",
    "libphonenumber-js": "^1.11.2",
    "luxon": "^3.4.4",
    "ng2-charts": "^6.0.1",
    "ngrx-store-localstorage": "^17.0.0",
    "ngx-colors": "^3.6.0",
    "ngx-cookie-service": "^17.1.0",
    "ngx-cookieconsent": "^6.0.0",
    "ngx-mat-intl-tel-input": "^5.0.0",
    "ngx-material-timepicker": "^13.1.1",
    "path": "^0.12.7",
    "pdfmake": "^0.2.10",
    "replace-in-file": "^7.2.0",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.1",
    "rxjs-compat": "^6.6.7",
    "skeleton-screen-css": "^1.1.0",
    "timezones-list": "^3.0.3",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "zone.js": "~0.14.6"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular-eslint/builder": "^17.5.2",
