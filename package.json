{
  "name": "cleos",
  "version": "1.2.31-rc",
  "engines": {
    "node": "v22.14.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "start:dev": "ng serve --port 4300",
    "start:pwa": "http-server -p 4300 -c-1 dist/cleos -P http://localhost:4300\\?",
    "build": "ng build --configuration=production",
    "build-pwa": "ng build --configuration=pwa",
    "build-development": "ng build --configuration=development",
    "build:pwa-old": "docker build -t nails-app --build-arg BUILD_CONFIG=build-pwa --build-arg NGINX=nginx-staging.conf .",
    "postbuild-pwa": "cp -r ./src/manifest-dev.json ./dist/cleos/manifest.json && cp ./src/firebase-messaging-sw-dev.js ./dist/cleos/firebase-messaging-sw-dev.js",
    "build:source": "ng build --source-map",
    "test": "ng test",
    "lint": "ng lint",
    "lint-fix": "ng lint --fix",
    "eslint": "eslint src --fix",
    "e2e": "start-server-and-test serve http://localhost:4300 'cypress run --headless --reporter junit --reporter-options mochaFile=cypress/results/test-results.xml'",
    "serve": "ng serve --port 4300 --host 0.0.0.0 --no-hmr",
    "e2e-html-report": "npm run start:dev & npx wait-on http://localhost:4300 && npx cypress run --headless; exit_code=$?; npm run report:merge && npm run report:generate; exit $exit_code",
    "report:merge": "npx mochawesome-merge cypress/reports/mochawesome/*.json > cypress/reports/mochawesome/report.json",
    "report:generate": "npx marge cypress/reports/mochawesome/report.json -o cypress/reports/mochawesome",
    "heroku-postbuild": "ng build --configuration=staging",
    "emulator": "firebase emulators:start",
    "cypress:open": "npm run start:dev & npx wait-on http://localhost:4300 && npx cypress open",
    "cypress:run": "cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.2",
    "@angular/cdk": "^19.2.3",
    "@angular/common": "^19.2.2",
    "@angular/compiler": "^19.2.2",
    "@angular/core": "^19.2.2",
    "@angular/fire": "^19.0.0",
    "@angular/forms": "^19.2.2",
    "@angular/google-maps": "^19.2.3",
    "@angular/material": "^19.2.3",
    "@angular/material-date-fns-adapter": "^19.2.3",
    "@angular/platform-browser": "^19.2.2",
    "@angular/platform-browser-dynamic": "^19.2.2",
    "@angular/router": "^19.2.2",
    "@angular/service-worker": "^19.2.2",
    "@ng-icons/core": "^31.2.0",
    "@ng-icons/flag-icons": "^31.2.0",
    "@ngrx/effects": "^19.0.1",
    "@ngrx/store": "^19.0.1",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "angular-calendar": "^0.31.1",
    "chart.js": "^4.4.8",
    "cookieconsent": "^3.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "11.5.0",
    "libphonenumber-js": "^1.12.6",
    "luxon": "^3.5.0",
    "ng2-charts": "^8.0.0",
    "ngrx-store-localstorage": "^19.0.0",
    "ngx-color-picker": "^19.0.0",
    "ngx-cookie-service": "^19.1.2",
    "ngx-cookieconsent": "^8.0.0",
    "ngx-material-intl-tel-input": "^19.2.1",
    "ngx-material-timepicker": "^13.1.1",
    "path": "^0.12.7",
    "pdfmake": "^0.2.18",
    "replace-in-file": "^8.3.0",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.2",
    "rxjs-compat": "^6.6.7",
    "skeleton-screen-css": "^1.1.0",
    "timezones-list": "^3.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.3",
    "@angular-eslint/builder": "^19.2.1",
    "@angular-eslint/eslint-plugin": "^19.2.1",
    "@angular-eslint/eslint-plugin-template": "^19.2.1",
    "@angular-eslint/schematics": "^19.2.1",
    "@angular-eslint/template-parser": "^19.2.1",
    "@angular/cli": "^19.2.3",
    "@angular/compiler-cli": "^19.2.2",
    "@angular/localize": "^19.2.2",
    "@cypress/schematic": "^3.0.0",
    "@ngrx/schematics": "^19.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/google.maps": "^3.58.1",
    "@types/html-to-pdfmake": "^2.4.4",
    "@types/jasmine": "~5.1.7",
    "@types/node": "^22.13.10",
    "@types/pdfmake": "^0.2.11",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "cypress": "latest",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsdoc": "50.6.8",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jasmine-core": "~5.6.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "ng2-charts-schematics": "^0.1.7",
    "start-server-and-test": "^2.0.11",
    "ts-node": "~10.9.2",
    "wait-on": "^8.0.3"
  }
}
