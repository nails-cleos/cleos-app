    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/build": "^20.3.14",
    "@angular/cli": "^20.3.14",
    "@angular/compiler-cli": "^20.3.16",
    "@angular/localize": "^20.3.16",
    "@cypress/schematic": "^5.0.0",
    "@ngrx/schematics": "^20.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/google.maps": "^3.58.1",
    "@types/html-to-pdfmake": "^2.4.4",
    "@types/jasmine": "~5.1.13",
    "@types/node": "^22.13.10",
    "@types/pdfmake": "^0.2.12",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "angular-draggable-droppable": "^9.0.1",
    "angular-resizable-element": "^8.0.1",
    "cypress": "latest",
    "eslint": "^9.39.2",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.0",
    "mochawesome-report-generator": "^6.3.2",
    "ng2-charts-schematics": "^0.1.7",
