{
  "extends": [
    "../.eslintrc.json"
  ],
  "plugins": [
    "cypress"
  ],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "overrides": [
    {
      "files": [
        "**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-namespace": "off",
        "@typescript-eslint/no-unused-expressions": "off"
      }
    }
  ]
}
