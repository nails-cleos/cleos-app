{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "node"],
    "skipLibCheck": true,
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@app/*": ["src/app/*"]
    },
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/**/*.ts"],
  "exclude": ["../node_modules"]
}
